# Set these in your hosting provider's secret/environment settings, not in source control.
# DATABASE_URL=postgresql://user:password@host:5432/skyguard
# SKYGUARD_DATA_DIR=/data/runtime
# SKYGUARD_TRUST_PROXY=1
# SKYGUARD_EMAIL_ENABLED=1
# SKYGUARD_EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-resend-api-key
# SKYGUARD_EMAIL_FROM=onboarding@resend.dev
# SKYGUARD_EMAIL_TO=your-resend-account-email@example.com
